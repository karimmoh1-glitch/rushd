# PostgreSQL connection string. Local dev example (Homebrew Postgres, no password):
# postgresql://<os-user>@localhost:5432/rushd_dev?schema=public
# Production: use your managed Postgres provider's connection string (Neon, Supabase, Railway, RDS...).
DATABASE_URL="postgresql://user:password@localhost:5432/rushd_dev?schema=public"

# Secret key used to sign session JWTs. Generate with: openssl rand -base64 32
# Rotating this invalidates all existing sessions.
SESSION_SECRET="replace-with-output-of-openssl-rand--base64-32"

# Optional. Enables AI quick-add parsing and "why this is prioritized" explanations.
# When unset, Rushd falls back to deterministic parsing/explanations — the app never
# requires this to function.
ANTHROPIC_API_KEY=""

# Base URL of the deployed app, used for metadata/OG tags and absolute links. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Set to "1" (any truthy value) to require a valid invite code to sign up —
# for gating a pilot rollout. Unset by default: signup stays open to everyone.
# Generate codes from /admin once a real user is signed in as an admin.
REQUIRE_INVITE_CODE=""

# Required for the Canvas LMS integration. Encrypts students' Canvas access
# tokens at rest (AES-256-GCM). Generate once with: openssl rand -base64 32
# Must stay the same across deployments — changing it means every student has
# to reconnect Canvas (nothing else is lost). Never commit the real value.
CANVAS_TOKEN_ENCRYPTION_KEY=""

# Optional. YouTube Data API v3 key. Lets the tutor recommend videos (only from
# established education channels, each one confirmed to exist). Without it,
# recommendations fall back to practice and the student's own course pages.
YOUTUBE_API_KEY=""

# Optional. Stripe billing for the Plus and Pro plans. Without these, upgrade
# buttons explain that billing isn't set up and everyone stays on Free.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PRO=""

# Optional. AI spend controls. A monthly cap in US dollars (also editable at
# /admin/ai), and an emergency off switch: set AI_KILL_SWITCH=on to stop all
# AI calls without a deploy.
AI_MONTHLY_BUDGET_USD=""
AI_KILL_SWITCH=""

# Optional. Microsoft Teams for Education (read-only). From a Microsoft Entra
# app registration; see docs/SETUP.md. Redirect URI must be
# ${NEXT_PUBLIC_APP_URL}/api/integrations/teams/callback. Tenant defaults to
# "organizations" (any school or work account); set a tenant ID to restrict it.
# Refresh tokens are encrypted with CANVAS_TOKEN_ENCRYPTION_KEY.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Optional. Email through Resend (https://resend.com): password reset links,
# the Sunday "your week" email, and streak reminders. Verify your sending
# domain in Resend first. Without these, email features stay off and
# password recovery falls back to admin-issued reset links.
RESEND_API_KEY=""
EMAIL_FROM="Rushd <hello@therushd.com>"

# Required for the daily/evening Vercel Cron jobs (vercel.json). Any long
# random string: openssl rand -hex 32. Vercel sends it as a Bearer token.
CRON_SECRET=""

# Optional. Minimum level for the structured server logs (src/lib/log.ts):
# debug | info | warn | error. Default: info.
LOG_LEVEL=
