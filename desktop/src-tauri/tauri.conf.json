{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rushd",
  "version": "0.1.0",
  "identifier": "com.therushd.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "https://therushd.com",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rushd",
    "copyright": "Copyright © 2026 Rushd",
    "category": "Productivity",
    "shortDescription": "Rushd for desktop",
    "longDescription": "Rushd for desktop is a secure native window for the Rushd web app at https://therushd.com. It requires an internet connection.",
    "homepage": "https://therushd.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
