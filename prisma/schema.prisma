// Rushd — database schema.
// See /docs/ARCHITECTURE.md for the reasoning behind the entity list, and
// /docs/PLANNING_ENGINE.md for how Assignment/Exam/StudyAvailability feed
// the scoring engine that produces Plan/PlanItem rows.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Explicit on Prisma 6.x (implicit/only option on 7.x, which this project
  // deliberately does not use — see docs/ARCHITECTURE.md, prisma/prisma#28657).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  isAdmin               Boolean   @default(false)
  onboardingCompletedAt DateTime?
  invitedByCodeId       String?
  // Bumped to revoke every outstanding session (password change, "sign out
  // everywhere"). Session tokens carry the version they were issued under.
  sessionVersion        Int       @default(0)
  // Personal invite code for /r/<code>; created the first time it's needed.
  referralCode          String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  profile          Profile?
  availability     StudyAvailability[]
  classes          Class[]
  assignments      Assignment[]
  exams            Exam[]
  plans            Plan[]
  planItems        PlanItem[]
  studySessions    StudySession[]
  notifications    Notification[]
  feedback         Feedback[]
  events           Event[]
  invitedByCode    InviteCode?         @relation(fields: [invitedByCodeId], references: [id])
  canvasConnection CanvasConnection?
  teamsConnection  TeamsConnection?
  calendarFeed     CalendarFeed?
  referralsMade    Referral[]          @relation("Referrer")
  referredBy       Referral?           @relation("Referred")
  scheduleBlocks   ScheduleBlock[]
  passwordResets   PasswordResetToken[]
  courseModules    CourseModule[]
  courseMaterials  CourseMaterial[]
  tutorChats       TutorConversation[]
  draftReviews     DraftReview[]
  subscription     Subscription?
  aiUsage          AiUsage[]
  assessments      Assessment[]
  masteryEvidence  MasteryEvidence[]

  @@index([createdAt])
}

// Onboarding-collected profile data. Split from User so auth logic never
// touches product-preference fields.
model Profile {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  displayName             String
  grade                   Int? // 9-12; null if not disclosed
  school                  String? // optional, never required
  timezone                String // IANA tz, e.g. "America/New_York"
  goals                   String? // free-text academic goals, optional
  primaryChallenge        AcademicChallenge? // self-reported at onboarding, optional
  // Scheduler preferences. Editable in Settings; the planner never assumes a
  // student's capacity beyond what they set here.
  preferredSessionMinutes Int                @default(60) // target length of one study block
  maxDailyMinutes         Int                @default(240) // ceiling on planned study per day
  // Tutor personalization: the student's own words plus a few structured
  // choices (validated by TutorPreferencesSchema). Fed to the tutor and to
  // feedback below the system rules, never above them.
  tutorInstructions       String?
  tutorPreferences        Json?
  // Study emails: the Sunday "your week" email and a nudge before a streak
  // ends. Off unless the student turns them on (onboarding or Settings).
  emailReminders          Boolean            @default(false)
  lastDigestAt            DateTime?
  lastNudgeAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Self-reported at onboarding — used to personalize copy (e.g. the Academic
// Profile page) and, later, to weight the planning engine's defaults (a
// student who says "procrastination" might get overdue work surfaced even
// more aggressively). Not acted on yet beyond copy — see docs/PLANNING_ENGINE.md.
enum AcademicChallenge {
  TOO_MANY_ASSIGNMENTS
  PROCRASTINATION
  POOR_TIME_ESTIMATION
  EXAM_STRESS
  STAYING_ORGANIZED
}

// A recurring weekly window the student is typically available to study.
// The planning engine expands these into concrete dates at scheduling time —
// there is no persisted "calendar instance" table (see PLANNING_ENGINE.md).
model StudyAvailability {
  id          String   @id @default(cuid())
  userId      String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from midnight, local to Profile.timezone
  endMinute   Int // exclusive; must be > startMinute
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Class {
  id        String   @id @default(cuid())
  userId    String
  name      String
  teacher   String?
  period    String?
  color     String   @default("#2563eb")
  priority  Priority @default(MEDIUM)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
  exams         Exam[]
  canvasCourses CanvasCourse[]
  teamsClasses  TeamsClass[]
  modules       CourseModule[]
  materials     CourseMaterial[]
  tutorChats    TutorConversation[]

  @@index([userId, archived])
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Where an assignment came from. Canvas-sourced rows are owned by the sync
// (Canvas is the source of truth for title/due date/completion); MANUAL rows
// are never touched by a sync, whether or not Canvas knows about them.
enum AssignmentSource {
  MANUAL
  CANVAS
  TEAMS
  CALENDAR
}

model Assignment {
  id               String           @id @default(cuid())
  userId           String
  classId          String
  title            String
  dueAt            DateTime
  estimatedMinutes Int              @default(30)
  priority         Priority         @default(MEDIUM)
  status           AssignmentStatus @default(NOT_STARTED)
  notes            String?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // --- Canvas sync identity & provenance (all null for MANUAL rows). ---------
  source             AssignmentSource @default(MANUAL)
  canvasCourseId     String? // Canvas's own course id
  canvasAssignmentId String? // Canvas's own assignment id
  canvasUrl          String? // link back to the assignment in Canvas
  pointsPossible     Float?
  canvasSubmittedAt  DateTime?
  canvasSyncedAt     DateTime?
  // Microsoft Teams identity for TEAMS rows. canvasUrl / canvasSyncedAt /
  // canvasRemovedAt are reused for Teams rows as the external link, last sync,
  // and "removed upstream" marker.
  teamsAssignmentId  String?
  teamsClassId       String?
  // Canvas calendar feed identity for CALENDAR rows (the event UID).
  feedUid            String?
  // Set when Canvas stops returning the assignment (deleted/unpublished). The
  // row is kept — it's the student's data — but dropped from planning.
  canvasRemovedAt    DateTime?
  // True while estimatedMinutes is Rushd's own default for an imported
  // assignment rather than a number the student chose. Editing it flips this
  // off, and a sync never overwrites a student-chosen estimate.
  estimatedByRushd   Boolean          @default(false)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  planItems      PlanItem[]
  studySessions  StudySession[]
  scheduleBlocks ScheduleBlock[]

  // One row per Canvas assignment per student — the backbone of idempotent
  // sync. NULL canvas ids (manual rows) never collide in Postgres.
  @@unique([userId, canvasCourseId, canvasAssignmentId])
  @@index([userId, status, dueAt])
  @@index([classId])
  @@index([userId, source])
  @@index([userId, teamsAssignmentId])
  @@index([userId, feedUid])
}

model Exam {
  id          String   @id @default(cuid())
  userId      String
  classId     String
  title       String
  examAt      DateTime
  prepMinutes Int      @default(120)
  priority    Priority @default(MEDIUM)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  class          Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  planItems      PlanItem[]
  studySessions  StudySession[]
  scheduleBlocks ScheduleBlock[]

  @@index([userId, examAt])
  @@index([classId])
}

// ---------------------------------------------------------------------------
// Planning engine output
// ---------------------------------------------------------------------------

// One row per plan generation. History is kept (not overwritten) so we can
// measure whether adaptation is actually happening and answer "is Rushd
// helping" from real data rather than a snapshot.
model Plan {
  id          String   @id @default(cuid())
  userId      String
  generatedAt DateTime @default(now())
  horizonDays Int      @default(7)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlanItem[]

  @@index([userId, generatedAt])
}

enum PlanItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

// A single scheduled study block, produced by the deterministic scoring
// engine. Exactly one of assignmentId/examId is set — enforced in
// src/lib/planning, not at the DB level (Prisma has no partial CHECK
// constraints without raw SQL, and this isn't worth a migration).
model PlanItem {
  id               String         @id @default(cuid())
  planId           String
  userId           String
  assignmentId     String?
  examId           String?
  scheduledDate    DateTime // date only, local to Profile.timezone
  scheduledMinutes Int
  score            Float // transparent priority score at generation time
  reasonCode       String // e.g. "OVERDUE", "EXAM_PROXIMITY", "DUE_SOON" — see PLANNING_ENGINE.md
  status           PlanItemStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exam          Exam?          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@index([planId])
  @@index([userId, scheduledDate])
  @@index([assignmentId])
  @@index([examId])
}

// ---------------------------------------------------------------------------
// Study execution — observed reality, feeding back toward the planning engine
// ---------------------------------------------------------------------------

enum StudySessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum StudySessionSource {
  PLANNED // started from a surface that showed Rushd's plan (One Thing, Today)
  MANUAL // started directly from the Assignments/Exams list
}

enum AbandonReason {
  RAN_OUT_OF_TIME
  HARDER_THAN_EXPECTED
  GOT_DISTRACTED
  NEED_HELP
  SOMETHING_CAME_UP
  OTHER
}

// Subjective difficulty, captured once at completion. actualMinutes vs
// plannedMinutes already answers "faster or slower than predicted" — this
// captures the question that number can't: whether it *felt* harder, which
// is its own signal (e.g. a session that ran exactly on time but felt brutal
// is different from one that ran over but felt easy).
enum PerceivedDifficulty {
  EASIER
  AS_EXPECTED
  HARDER
}

// A raw observation of one real study attempt: what the deterministic engine
// predicted right before the session started, and what actually happened.
// This is Rushd's first PREDICT -> EXECUTE -> MEASURE feedback loop — see
// docs/PLANNING_ENGINE.md "Future estimation architecture." Deliberately
// denormalized (className/classColor/predictedScore/reasonCode captured as
// plain values, not joined live from Assignment/Class at read time) — a
// session is a historical record of what was true *then*; it shouldn't
// silently shift if the assignment or class is edited afterward. Exactly one
// of assignmentId/examId is set — enforced in application code, the same
// documented tradeoff as PlanItem above.
model StudySession {
  id           String  @id @default(cuid())
  userId       String
  assignmentId String?
  examId       String?
  planItemId   String? // rarely populated in V1 — see docs/PLANNING_ENGINE.md

  source         StudySessionSource
  title          String
  plannedMinutes Int
  predictedScore Float
  reasonCode     String
  className      String
  classColor     String

  startedAt           DateTime             @default(now())
  endedAt             DateTime?
  actualMinutes       Int?
  status              StudySessionStatus   @default(IN_PROGRESS)
  abandonReason       AbandonReason?
  perceivedDifficulty PerceivedDifficulty?

  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exam       Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)
  planItem   PlanItem?   @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([assignmentId])
  @@index([examId])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum NotificationType {
  PLAN_CHANGED
  EXAM_APPROACHING
  OVERDUE_WORK
}

// Schema only for MVP — delivery (email/push) is not implemented. See ROADMAP.md.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  context   String // e.g. "plan", "onboarding", "general"
  rating    Int? // 1-5, optional
  message   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([context])
}

// Privacy-conscious product analytics. See /docs/PRODUCT.md#analytics.
model Event {
  id         String   @id @default(cuid())
  userId     String
  name       String // e.g. "plan_generated", "assignment_completed"
  properties Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
}

// Pilot rollout gating. Codes are always attributable (signup form captures
// one optionally, for cohort tracking), but only *required* to sign up when
// REQUIRE_INVITE_CODE is set — see .env.example. maxUses null = unlimited.
model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String? // e.g. "Lincoln High pilot"
  maxUses   Int?
  createdAt DateTime @default(now())

  users User[]
}

// ---------------------------------------------------------------------------
// Canvas LMS integration
// ---------------------------------------------------------------------------

enum CanvasConnectionStatus {
  ACTIVE
  NEEDS_REAUTH // Canvas rejected the token (expired/revoked) — reconnect to resume
  ERROR // last sync failed for a non-auth reason; safe to retry
}

// One Canvas account per student. The personal access token is stored ONLY as
// AES-256-GCM ciphertext (see src/lib/canvas/token-vault.ts), bound to the
// owning userId, and is never selected into any client-facing query. Deleting
// the row IS the revocation on Rushd's side; the student should also delete
// the token in Canvas (Account > Settings > Approved Integrations).
model CanvasConnection {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  baseUrl         String // normalized origin, e.g. https://school.instructure.com
  encryptedToken  String
  canvasUserId    String?
  canvasUserName  String?
  status          CanvasConnectionStatus @default(ACTIVE)
  lastSyncAt      DateTime?
  lastSyncStatus  String? // "ok" | "partial" | "error"
  lastSyncError   String? // user-facing, never contains the token
  lastSyncSummary Json?
  syncStartedAt   DateTime? // soft lock so two syncs can't interleave
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses CanvasCourse[]
}

model CanvasCourse {
  id             String    @id @default(cuid())
  connectionId   String
  canvasCourseId String
  name           String
  courseCode     String?
  termName       String?
  selected       Boolean   @default(false)
  classId        String? // the Rushd Class this course syncs into
  lastSyncedAt   DateTime?
  // Course content (modules, pages, announcements, rubrics) syncs separately
  // from assignments; these record its last run.
  contentSyncedAt DateTime?
  contentSyncNote String? // user-facing, e.g. "Pages aren't visible to students in this course."
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection CanvasConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  class      Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([connectionId, canvasCourseId])
  @@index([classId])
}

// ---------------------------------------------------------------------------
// Student-controlled schedule
// ---------------------------------------------------------------------------

// A study block the student placed or locked by hand. The auto-planner treats
// these as fixed commitments (see src/lib/planning/schedule.ts): it plans
// around them, counts them toward the item's remaining work, and never moves
// them on regeneration. Everything else in the plan is recomputed.
model ScheduleBlock {
  id              String   @id @default(cuid())
  userId          String
  assignmentId    String?
  examId          String?
  localDate       String // "YYYY-MM-DD" in the student's timezone
  startMinute     Int // minutes from local midnight
  durationMinutes Int
  createdAt       DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  exam       Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
}

// Shared fixed-window counters for rate limiting, so limits hold across
// serverless instances. Keys are SHA-256 digests (never raw emails or IPs).
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Single-use password reset links. Only a SHA-256 digest of the token is
// stored; the raw token exists only in the link handed to the student.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Course content mirrored read-only from Canvas, for browsing and the tutor.
// A cache of Canvas, not student data: rows are replaced on every content sync.
// ---------------------------------------------------------------------------

model CourseModule {
  id             String   @id @default(cuid())
  userId         String
  classId        String
  canvasCourseId String
  canvasModuleId String
  name           String
  position       Int
  syncedAt       DateTime

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  materials CourseMaterial[]

  @@unique([userId, canvasCourseId, canvasModuleId])
  @@index([userId, classId])
}

enum CourseMaterialKind {
  MODULE_ITEM
  PAGE
  ASSIGNMENT
  ANNOUNCEMENT
}

model CourseMaterial {
  id             String             @id @default(cuid())
  userId         String
  classId        String
  canvasCourseId String
  kind           CourseMaterialKind
  canvasId       String // Canvas's id for the object (a page's url slug for pages)
  moduleId       String?
  position       Int?
  indent         Int?
  itemType       String? // module items: Page, Assignment, File, Quiz, SubHeader, ExternalUrl, ...
  targetId       String? // module items: the Canvas id of what it points to (page url slug, assignment id, ...)
  title          String
  url            String? // https link on the connected Canvas origin only
  body           String? // plain text extracted from Canvas HTML
  postedAt       DateTime?
  pointsPossible Float?
  rubric         Json? // validated RubricCriterion[] (see src/lib/canvas/content.ts)
  assignmentId   String? // the Rushd Assignment this mirrors, for kind ASSIGNMENT
  syncedAt       DateTime
  // Full-text index over title + body; a generated column maintained by
  // Postgres (see the migration), never written by the app.
  searchVector   Unsupported("tsvector")?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  class  Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  module CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasCourseId, kind, canvasId])
  @@index([userId, classId, kind])
  @@index([assignmentId])
}

// ---------------------------------------------------------------------------
// Tutor
// ---------------------------------------------------------------------------

model TutorConversation {
  id           String   @id @default(cuid())
  userId       String
  classId      String?
  assignmentId String?
  mode         String   @default("explain") // explain | quiz | plan
  title        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class    Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  messages TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  // [{ id, title, kind, url }] resolved server-side from CourseMaterial rows
  // the tutor actually read this turn. Never model-generated.
  sources        Json?
  createdAt      DateTime @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A rubric-based AI estimate of a draft. Drafts are stored so revisions can be
// compared; the student can delete any review.
model DraftReview {
  id           String   @id @default(cuid())
  userId       String
  assignmentId String
  label        String
  draftText    String
  result       Json // validated DraftReviewResult
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assignmentId, createdAt])
}

// ---------------------------------------------------------------------------
// Plans, billing, and AI cost control
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  PLUS
  PRO
}

// Mirrors the student's Stripe subscription. Written only by the verified
// webhook handler; entitlements are derived from it on the server.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 PlanTier  @default(FREE)
  status               String    @default("none") // Stripe status: active, trialing, past_due, canceled, ...
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Processed Stripe webhook events, for idempotency.
model StripeEvent {
  id          String   @id // Stripe's event id
  type        String
  processedAt DateTime @default(now())
}

// One row per AI request: reserved before the call (with a bounded cost
// estimate), settled after it with the provider-reported token usage. Never
// stores prompts or content.
model AiUsage {
  id                  String    @id @default(cuid())
  userId              String?
  feature             String // tutor_message | photo_assessment | draft_review | quick_add | screenshot_import
  model               String
  status              String // reserved | completed | failed
  estimatedCostMicros Int // reservation, in millionths of a dollar
  costMicros          Int? // computed from provider-reported usage after completion
  inputTokens         Int?
  outputTokens        Int?
  cacheReadTokens     Int?
  cacheWriteTokens    Int?
  errorType           String?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Requests turned away by quotas or the circuit breaker (no provider call made).
model AiRejection {
  id        String   @id @default(cuid())
  userId    String?
  feature   String
  reason    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Operator-adjustable settings (global AI budget, kill switch).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Practice, assessments, and mastery
// ---------------------------------------------------------------------------

model Assessment {
  id           String   @id @default(cuid())
  userId       String
  classId      String?
  source       String // photo | text
  subject      String
  topic        String
  topicKey     String
  itemsAssessed Int
  estimateLow  Float // 0-100
  estimateHigh Float // 0-100
  confidence   String // low | medium | high
  result       Json // validated AssessmentResult (summary, skills, gaps, next steps, practice, resources)
  createdAt    DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence MasteryEvidence[]

  @@index([userId, createdAt])
}

// Topic-level evidence. Mastery is computed from these rows on read
// (recency-weighted), so a single result never fixes a topic's level.
model MasteryEvidence {
  id           String   @id @default(cuid())
  userId       String
  classId      String?
  topicKey     String
  topicLabel   String
  score        Float // 0-1 for this piece of evidence
  weight       Float // how much evidence it carries (e.g. gradable items)
  source       String // assessment | practice
  assessmentId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId, topicKey, createdAt])
}

// ---------------------------------------------------------------------------
// Growth
// ---------------------------------------------------------------------------

model SchoolInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  role         String
  organization String
  studentCount String?
  interest     String // pilot | information | partnership
  message      String
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Anonymous, cookieless page counts for public pages (no identifiers).
model PageView {
  day   DateTime @db.Date
  path  String
  count Int      @default(0)

  @@id([day, path])
}

// ---------------------------------------------------------------------------
// Microsoft Teams (Education) — read-only, like Canvas.
// ---------------------------------------------------------------------------

model TeamsConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  encryptedRefreshToken String // AES-256-GCM, bound to userId (token-vault.ts)
  accountName           String?
  tenantId              String?
  status                String    @default("ACTIVE") // ACTIVE | NEEDS_REAUTH | ERROR
  lastSyncAt            DateTime?
  lastSyncError         String?
  syncStartedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes TeamsClass[]
}

model TeamsClass {
  id           String   @id @default(cuid())
  connectionId String
  teamsClassId String
  name         String
  selected     Boolean  @default(false)
  classId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection TeamsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  class      Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([connectionId, teamsClassId])
  @@index([classId])
}

// A student's private Canvas calendar feed, for schools that turn off
// personal access tokens. The URL is a capability (anyone with it can read the
// calendar), so it is stored encrypted like a token.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  encryptedUrl  String
  host          String
  status        String    @default("ACTIVE") // ACTIVE | ERROR
  lastSyncAt    DateTime?
  lastSyncError String?
  syncStartedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One student inviting another. It counts (both get bonus tutor messages)
// once the invited student does a real study action, which keeps throwaway
// sign-ups from earning anything.
model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String    @unique
  createdAt   DateTime  @default(now())
  qualifiedAt DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId, qualifiedAt])
}
